# NVIDIA NIM API Key (Get free key with 1000 credits at https://build.nvidia.com)
NVIDIA_NIM_API_KEY="nvapi-your-key-here"

# OpenRouter API Key (Optional, get free key at https://openrouter.ai)
OPENROUTER_API_KEY=""

# DeepSeek API Key (Optional, get at https://platform.deepseek.com)
DEEPSEEK_API_KEY=""

# Platform settings
MESSAGING_PLATFORM="none"
VOICE_NOTE_ENABLED=false

# ==============================================================================
# Model Routing Configuration
# Format: <provider_id>/<model_name>
# Providers: nvidia_nim, open_router, deepseek, lmstudio, llamacpp
# ==============================================================================

# Frontier Reasoning & Complex Architecting (Routes Claude Opus requests)
MODEL_OPUS="nvidia_nim/mistralai/mistral-large-4-1t-a52b"

# High-Performance Flash Coding & Tool Execution (Routes Claude Sonnet requests)
MODEL_SONNET="nvidia_nim/nvidia/nemotron-3.5-lightning-30b-a3b"

# Fast Everyday Coding & Tasks (Routes Claude Haiku requests)
MODEL_HAIKU="nvidia_nim/nvidia/nemotron-3.5-lightning-30b-a3b"

# Global Fallback Model
MODEL="nvidia_nim/nvidia/nemotron-3.5-lightning-30b-a3b"

# Enable Thinking / Reasoning tokens
ENABLE_THINKING=false

# Local Proxy Server Host & Port
HOST="127.0.0.1"
PORT=8082
